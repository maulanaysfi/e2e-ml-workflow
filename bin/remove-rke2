AGENTS_STRING="35.206.198.165,35.206.252.187,35.206.237.7"
IFS=',' read -ra AGENTS_ARR <<< "${AGENTS_STRING}"

for AGENT in "${AGENTS_ARR[@]}"; do
    AGENT=$(echo "${AGENT}" | xargs)
    echo -e "[!] Removing RKE2 on ${AGENT}...\n"
    ssh -o StrictHostKeyChecking=no -T root@${AGENT} <<EOSSH
rke2-uninstall.sh
sleep 15
rm -rfv /var/lib/calico/ /var/run/calico/ /var/run/istio-cni/ /var/run/k3s/ /var/run/ztunnel/
EOSSH
    echo -e "[+] Done removing on ${AGENT}.\n\n"
done
